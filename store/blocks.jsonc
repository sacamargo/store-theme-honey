            "rich-text#global--ofertas"
        ],
        "props": {
            "blockClass": "flex--custom-page"
        }
    },
    "rich-text#global--ofertas": {
        "props": {
            "blockClass": "text-custom-page",
            "text": "¡Ofertas de Enero!",
            "font": "t-heading-1"
        }
    },
    "store.custom#cyber--monday": {
        "blocks": [
            "flex-layout.row#rich--cyber",
            "flex-layout.row#product-list"
        ]
    },

    "flex-layout.row#rich--cyber": {
        "children": [
            "rich-text#global--cyber"
        ],
        "props": {
            "blockClass": "flex--custom-page"
        }
    },
    "rich-text#global--cyber": {
        "props": {
            "blockClass": "text-custom-page",
            "text": "¡Cyber Monday!",
            "font": "t-heading-1"
        }
    },
    "store.custom#never--say-never": {
        "blocks": [
            "flex-layout.row#rich--never",
            "flex-layout.row#product-list"
        ]
    },

    "flex-layout.row#rich--never": {
        "children": [
            "rich-text#global--never"
        ],
        "props": {
            "blockClass": "flex--custom-page"
        }
    },
    "rich-text#global--never": {
        "props": {
            "blockClass": "text-custom-page",
            "text": "¡Never say never!",
            "font": "t-heading-1"
        }
    }
}