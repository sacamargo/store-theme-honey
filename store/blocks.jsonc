{
    "store.custom#tendencias--itg": {
        "blocks": [
            "flex-layout.row#rich--tendencias",
            "flex-layout.row#product-list"
        ]
    },

    "flex-layout.row#rich--tendencias": {
        "children": [
            "rich-text#global--tendencias"
        ],
        "props": {
            "blockClass": "flex--tendencias"
        }
    },
    "rich-text#global--tendencias": {
        "props": {
            "blockClass": "tendencias--itg",
            "text": "¡Tendencias de ITGlobers!",
            "font": "t-heading-1"
        }
    },
    "store.custom#coleccion--mes": {
        "blocks": [
            "flex-layout.row#rich--coleccion",
            "flex-layout.row#product-list"
        ]
    },

    "flex-layout.row#rich--coleccion": {
        "children": [
            "rich-text#global--coleccion"
        ],
        "props": {
            "blockClass": "flex--custom-page"
        }
    },
    "rich-text#global--coleccion": {
        "props": {
            "blockClass": "text-custom-page",
            "text": "¡Coleccion del mes!",
            "font": "t-heading-1"
        }
    },
    "store.custom#ofertas--enero": {
        "blocks": [
            "flex-layout.row#rich--ofertas",
